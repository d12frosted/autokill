<Project>

  <!--
    Locate the Dalamud dev assemblies. Order of preference:
      1. DALAMUD_HOME environment variable (or -p:DalamudLibPath=... on the command line)
      2. Windows: XIVLauncher's addon/Hooks/dev
      3. macOS: XIV on Mac
      4. Linux / XIVLauncher.Core: ~/.xlcore
    Trailing slash matters, HintPath concatenates directly onto it.
  -->
  <PropertyGroup>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' AND '$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' AND '$(OS)' == 'Windows_NT'">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' AND Exists('$(HOME)/Library/Application Support/XIV on Mac/dalamud/Hooks/dev')">$(HOME)/Library/Application Support/XIV on Mac/dalamud/Hooks/dev/</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' AND Exists('$(HOME)/.xlcore/dalamud/Hooks/dev')">$(HOME)/.xlcore/dalamud/Hooks/dev/</DalamudLibPath>
  </PropertyGroup>

  <Target Name="CheckDalamudLibPath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(DalamudLibPath)Dalamud.dll')"
           Text="Dalamud.dll not found under '$(DalamudLibPath)'. Set DALAMUD_HOME to your Dalamud dev directory (the one containing Dalamud.dll)." />
  </Target>

</Project>
